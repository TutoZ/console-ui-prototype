{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port=5190 --host=127.0.0.1 --strictPort",
    "build": "node scripts/optimize-assets.mjs && vite build && node scripts/prune-dist-fonts.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "build:workflow": "vite build --config vite.workflow.config.ts",
    "build:ui": "npm run build -w @joysupport/ui",
    "pack:ui": "npm run build -w @joysupport/ui && npm pack -w @joysupport/ui",
    "preview": "vite preview --host=127.0.0.1 --port=5190",
    "share": "lt --port 5190",
    "deploy": "npm run build && vercel deploy dist --prod",
    "deploy:cos": "npm run build && node scripts/deploy-cos.mjs",
    "setup:cos": "node scripts/setup-and-deploy-cos.mjs",
    "bind:cos-domain": "node scripts/bind-cos-domain.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@google/genai": "^2.4.0",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/react": "^6.0.2",
    "@joysupport/ui": "*",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "nucleo-glass-icons": "^0.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "localtunnel": "^2.0.2",
    "sass": "^1.101.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wawoff2": "^2.0.1"
  }
}
