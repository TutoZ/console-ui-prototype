{
  "name": "@joysupport/ui",
  "version": "0.1.1",
  "description": "JoySupport（京小灵）设计系统：样式常量 + 无业务耦合组件，供其他前端项目直接引用与风格对齐。",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css && mkdir -p dist/assets && cp src/assets/matrix-loader.svg dist/assets/matrix-loader.svg",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsup": "^8.5.0",
    "typescript": "~5.8.2"
  },
  "keywords": [
    "joysupport",
    "design-system",
    "react",
    "tailwind"
  ]
}
